{
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "unideals.co" }],
      "destination": "https://www.unideals.co/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "unideals-nine.vercel.app" }],
      "destination": "https://www.unideals.co/:path*",
      "permanent": true
    },
    {
      "source": "/perks",
      "destination": "/deals",
      "statusCode": 301
    },
    {
      "source": "/perks/:id",
      "destination": "/deals/:id",
      "statusCode": 301
    },
    {
      "source": "/signup",
      "destination": "/?auth=signup",
      "statusCode": 302
    },
    {
      "source": "/login",
      "destination": "/?auth=login",
      "statusCode": 302
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(twitterbot|facebookexternalhit|linkedinbot|skypeuripreview|pinterest|slackbot|vkShare|W3C_Validator|atproto).*"
        }
      ],
      "destination": "/api/og-proxy?slug=:slug"
    },
    {
      "source": "/deals/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(twitterbot|facebookexternalhit|linkedinbot|skypeuripreview|pinterest|slackbot|vkShare|W3C_Validator|atproto).*"
        }
      ],
      "destination": "/api/deal-og-proxy?id=:id"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        }
      ]
    },
    {
      "source": "/:file(apple-touch-icon.*|icon-.*|logo.*|favicon-.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
