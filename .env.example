# Copy to .env.local and fill in values from the Supabase dashboard.
# Never commit .env.local or real keys.
#
# Google sign-in uses the Google provider in the Supabase dashboard
# (Authentication → Providers → Google). No extra Vite env vars are needed.
# Allowlist http://localhost:5173/auth/callback and the production
# https://www.unideals.co/auth/callback redirect URLs.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional. Public by design (shipped in the client bundle).
# Set these in Vercel → Production only so preview/localhost stay out of reports.
# Scripts load only on www.unideals.co when the matching id is present.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
